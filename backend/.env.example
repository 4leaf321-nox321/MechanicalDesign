# Mechanical Design - Backend Environment Template
#
# 이 파일을 .env 로 복사한 뒤 값들을 채워서 사용하세요.
#   copy .env.example .env
#
# SECRET_KEY / JWT_SECRET_KEY 생성:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# === Flask ===
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5176

# === Secrets (필수: 반드시 랜덤 값으로 변경) ===
# FLASK_ENV=production 이면 기본값이거나 32자 미만인 경우 앱이 기동을 거부한다.
# 세션과 토큰을 위조할 수 있는 값이 운영에 남는 것을 막기 위해서다.
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING_1
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING_2

# === 인증 (전부 선택 — 비우면 아래 기본값) ===
# access 토큰 수명(분). 짧게 두면 정지된 계정이 빨리 끊기고, 길게 두면 갱신이 준다.
ACCESS_TOKEN_MINUTES=720
# refresh(로그인 유지) 수명(일).
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=md_refresh
# **http 로 서비스하면 false 여야 한다.** true 면 브라우저가 쿠키를 버려서
# 로그인은 되는데 새로고침하면 풀리는, 원인 찾기 어려운 형태로 실패한다.
# https 를 붙였을 때만 true 로 올린다.
REFRESH_COOKIE_SECURE=false

# === Waitress (production 서버 스레드 수) ===
WAITRESS_THREADS=8

# === Database (PostgreSQL 비밀번호 채우기) ===
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/mechanicaldesign

# === 업로드 저장 위치 ===
# 비워 두면 backend/uploads/ 를 쓴다(개발 기본값).
# 운영 배포는 앱 폴더 바깥을 가리킨다 — install.ps1 이 자동으로 채운다.
# 예: UPLOAD_DIR=C:\Server\MechanicalDesign_data\uploads
UPLOAD_DIR=

# === CORS ===
# 같은 서버/포트에서 프론트와 백엔드를 서빙하면 비워두거나 생략 가능.
# 다른 도메인에서 접속하는 경우에만 설정 (쉼표로 여러 개 가능)
# 예: CORS_ORIGINS=http://192.168.1.10:5176,https://example.com
CORS_ORIGINS=

# === MCP (optional) ===
# Address shown on the token page so people can copy a ready-to-run
# "claude mcp add" command. Leave both blank in a normal install: the server
# derives the address from the host the user actually reached.
# Set MCP_PORT if install-mcp.ps1 -Port was changed.
# Set MCP_URL to override the whole address (reverse proxy, https).
MCP_PORT=3010
MCP_URL=
