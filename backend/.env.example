# Mechanical Design - Backend Environment Template
#
# 이 파일을 .env 로 복사한 뒤 값들을 채워서 사용하세요.
#   copy .env.example .env
#
# SECRET_KEY / JWT_SECRET_KEY 생성:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# === Flask ===
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5174

# === Secrets (필수: 반드시 랜덤 값으로 변경) ===
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING_1
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING_2

# === Waitress (production 서버 스레드 수) ===
WAITRESS_THREADS=8

# === Database (PostgreSQL 비밀번호 채우기) ===
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/mechanicaldesign

# === CORS ===
# 같은 서버/포트에서 프론트와 백엔드를 서빙하면 비워두거나 생략 가능.
# 다른 도메인에서 접속하는 경우에만 설정 (쉼표로 여러 개 가능)
# 예: CORS_ORIGINS=http://192.168.1.10:5174,https://example.com
CORS_ORIGINS=
